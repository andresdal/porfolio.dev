---
import Layout from "@/layouts/Layout.astro"

import AboutMeNew from "@/components/AboutMeNew.astro"
import Briefcase from "@/components/icons/Briefcase.astro"
import CodeIcon from "@/components/icons/Code.astro"
import ExperienceNew from "@/components/ExperienceNew.astro"
import ProfileCheck from "@/components/icons/ProfileCheck.astro"
import ProjectsNew from "@/components/ProjectsNew.astro"
import SectionContainerNew from "@/components/SectionContainerNew.astro"
import Hero from "@/components/Hero.astro"
import TitleSectionNew from "@/components/TitleSectionNew.astro"
import Contact from "@/components/Contact.astro"
import MailIcon from "@/components/icons/Mail.astro"
import { useTranslations } from "@/i18n/utils"

const lang = 'es';
const t = useTranslations(lang);
---

<Layout
  title={t('meta.title')}
  description={t('meta.description')}
  lang={lang}
>
  <main>
    <SectionContainerNew class="hero-section">
      <Hero lang={lang} />
    </SectionContainerNew>

    <div class="sections-wrapper">
      <SectionContainerNew id="experiencia">
        <TitleSectionNew title={t('sections.experience')}>
          <Briefcase class="size-8" />
        </TitleSectionNew>
        <ExperienceNew lang={lang} />
      </SectionContainerNew>

      <SectionContainerNew id="proyectos">
        <TitleSectionNew title={t('sections.projects')}>
          <CodeIcon class="size-8" />
        </TitleSectionNew>
        <ProjectsNew lang={lang} />
      </SectionContainerNew>

      <SectionContainerNew id="sobre-mi">
        <TitleSectionNew title={t('sections.about')}>
          <ProfileCheck class="size-8" />
        </TitleSectionNew>
        <AboutMeNew lang={lang} />
      </SectionContainerNew>

      <SectionContainerNew id="contacto">
        <TitleSectionNew title={t('sections.contact')}>
          <MailIcon class="size-8" />
        </TitleSectionNew>
        <Contact lang={lang} />
      </SectionContainerNew>
    </div>
  </main>
</Layout>

<style>
  main {
    position: relative;
    z-index: 1;
    width: 100%;
    overflow-x: hidden;
  }

  .hero-section {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
  }

  .sections-wrapper {
    position: relative;
    width: 100%;
  }
</style>
</Layout>
